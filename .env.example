# Claude API key (or run `ant auth login` and leave this unset)
ANTHROPIC_API_KEY=

# Only needed when media.provider = webhook
MEDIA_WEBHOOK_URL=
# Only needed when publishing.provider = webhook
PUBLISH_WEBHOOK_URL=
# Optional shared secret sent as X-Gita-Studio-Signature (HMAC-SHA256 of the body)
WEBHOOK_SECRET=
# Only needed when media.provider = fal (https://fal.ai/dashboard/keys)
FAL_KEY=
